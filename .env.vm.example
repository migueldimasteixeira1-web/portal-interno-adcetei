# Copie este arquivo para .env antes de iniciar a VM.
ENVIRONMENT=staging
PORTAL_PORT=80

POSTGRES_DB=prefeitura_ti
POSTGRES_USER=prefeitura_ti
POSTGRES_PASSWORD=troque-por-uma-senha-forte
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# local para homologação sem AD; ldap ou hybrid após configurar o domínio.
AUTH_MODE=local
SEED_DEMO_DATA=false
SHOW_DEMO_USERS=false
CORS_ORIGINS=http://IP-OU-DNS-DA-VM

LDAP_SERVER=ldaps://dc01.cabofrio.local:636
LDAP_BIND_DN=CN=svc_portal_ti,OU=Servicos,DC=cabofrio,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=cabofrio,DC=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_HELPDESK_GROUP=GG_TI_HELPDESK
LDAP_TECHNICIAN_GROUP=GG_TI_TECNICOS
LDAP_ADMIN_GROUP=GG_TI_ADMIN

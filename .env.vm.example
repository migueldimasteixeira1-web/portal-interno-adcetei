# Copie este arquivo para .env antes de iniciar a VM.
ENVIRONMENT=staging
PORTAL_PORT=80

POSTGRES_DB=prefeitura_ti
POSTGRES_USER=prefeitura_ti
POSTGRES_PASSWORD=troque-por-uma-senha-forte
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

AUTH_MODE=email
INSTITUTIONAL_EMAIL_PATTERN=^[^@\s]+@[a-z0-9-]+\.cabofrio\.rj\.gov\.br$
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PUBLIC_APP_URL=http://IP-OU-DNS-DA-VM
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SEED_DEMO_DATA=false
SHOW_DEMO_USERS=false
CORS_ORIGINS=http://IP-OU-DNS-DA-VM

# Impressoras / CUPS
# Neste MVP, local_commands consulta apenas o CUPS local do processo da API.
# Em Docker, localhost é o container. A integração remota com o PrintServer
# ficará para o backend remote_ipp.
CUPS_ENABLED=true
CUPS_BACKEND=local_commands
CUPS_HOST=localhost
CUPS_PORT=631
CUPS_SCHEME=http

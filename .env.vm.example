# Copie este arquivo para .env antes de iniciar a VM.
ENVIRONMENT=staging
PORTAL_PORT=80

POSTGRES_DB=prefeitura_ti
POSTGRES_USER=prefeitura_ti
POSTGRES_PASSWORD=troque-por-uma-senha-forte
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

AUTH_MODE=email
INSTITUTIONAL_EMAIL_PATTERN=^[^@\s]+@[a-z0-9-]+\.cabofrio\.rj\.gov\.br$
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PUBLIC_APP_URL=http://IP-OU-DNS-DA-VM
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SEED_DEMO_DATA=false
SHOW_DEMO_USERS=false
CORS_ORIGINS=http://IP-OU-DNS-DA-VM

# Acesso remoto / MeshCentral
REMOTE_ACCESS_ENABLED=false
MESH_BRIDGE_URL=http://mesh-bridge:8080
MESH_BRIDGE_SHARED_SECRET=troque-por-uma-chave-grande
MESH_BRIDGE_MOCK=false
MESHCENTRAL_URL=https://remoto.exemplo.local
MESHCENTRAL_PUBLIC_URL=https://remoto.exemplo.local
MESHCENTRAL_ADMIN_USER=portal-integracao
MESHCENTRAL_ADMIN_PASS=troque-esta-senha
MESHCENTRAL_DOMAIN=
MESH_SESSION_URL_TEMPLATE=
MESH_SESSION_TTL_SECONDS=3600

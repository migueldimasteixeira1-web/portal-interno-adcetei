PORT=8080
MESH_BRIDGE_SHARED_SECRET=troque-por-uma-chave-grande
MESH_BRIDGE_MOCK=true
MESHCENTRAL_URL=https://remoto.exemplo.local
MESHCENTRAL_PUBLIC_URL=https://remoto.exemplo.local
MESHCENTRAL_ADMIN_USER=portal-integracao
MESHCENTRAL_ADMIN_PASS=senha-forte
MESHCENTRAL_DOMAIN=
MESHCENTRAL_LOGIN_TOKEN_KEY=
MESHCENTRAL_LOGIN_USER_ID=
# base64 (padrão) ou hex — precisa bater com o CookieEncoding do MeshCentral (config.json).
MESHCENTRAL_COOKIE_ENCODING=base64
MESH_SESSION_URL_TEMPLATE={publicUrl}/?login={loginToken}&node={nodeId}&gotonode={nodeId}&viewmode=11&hide=31
MESH_SESSION_TTL_SECONDS=3600
MESH_DEVICES_CACHE_TTL_MS=30000
NODE_TLS_REJECT_UNAUTHORIZED=0

APP_NAME=Portal Interno ADCETEI
ENVIRONMENT=local
SECRET_KEY=troque-esta-chave
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./prefeitura_ti.db
# Na VM, use POSTGRES_HOST/PORT/DB/USER/PASSWORD em vez de montar a URL manualmente.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=prefeitura_ti
POSTGRES_USER=prefeitura_ti
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:3000

# local | ldap | hybrid
AUTH_MODE=local
# Habilite somente em ambiente local ou de demonstração.
SEED_DEMO_DATA=true
LDAP_SERVER=ldaps://dc01.cabofrio.local:636
LDAP_BIND_DN=CN=svc_portal_ti,OU=Servicos,DC=cabofrio,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=cabofrio,DC=local
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_HELPDESK_GROUP=GG_TI_HELPDESK
LDAP_TECHNICIAN_GROUP=GG_TI_TECNICOS
LDAP_ADMIN_GROUP=GG_TI_ADMIN

APP_NAME=Portal Interno ADCETEI
ENVIRONMENT=local
SECRET_KEY=troque-esta-chave
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./prefeitura_ti.db
# Na VM, use POSTGRES_HOST/PORT/DB/USER/PASSWORD em vez de montar a URL manualmente.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=prefeitura_ti
POSTGRES_USER=prefeitura_ti
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:3000

AUTH_MODE=email
INSTITUTIONAL_EMAIL_PATTERN=^[^@\s]+@[a-z0-9-]+\.cabofrio\.rj\.gov\.br$
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Habilite somente em ambiente local ou de demonstração.
SEED_DEMO_DATA=true

# Impressoras / CUPS
# local_commands consulta o CUPS da máquina onde o backend FastAPI está rodando.
# Se o backend estiver em Docker, localhost é o container, não o host.
CUPS_ENABLED=true
CUPS_BACKEND=local_commands
CUPS_HOST=localhost
CUPS_PORT=631
CUPS_SCHEME=http
CUPS_CACHE_TTL_SECONDS=5
CUPS_EVENT_INTERVAL_SECONDS=3
CUPS_AUTO_REFRESH_SECONDS=10

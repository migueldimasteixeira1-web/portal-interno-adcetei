APP_NAME=Portal Interno ADCETEI
ENVIRONMENT=local
SECRET_KEY=troque-esta-chave
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./prefeitura_ti.db
# Na VM, use POSTGRES_HOST/PORT/DB/USER/PASSWORD em vez de montar a URL manualmente.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=prefeitura_ti
POSTGRES_USER=prefeitura_ti
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:3000

AUTH_MODE=email
INSTITUTIONAL_EMAIL_PATTERN=^[^@\s]+@[a-z0-9-]+\.cabofrio\.rj\.gov\.br$
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Habilite somente em ambiente local ou de demonstração.
SEED_DEMO_DATA=true

# Acesso remoto / MeshCentral
REMOTE_ACCESS_ENABLED=false
MESH_BRIDGE_URL=http://localhost:8080
MESH_BRIDGE_SHARED_SECRET=
MESH_SESSION_TTL_SECONDS=3600
